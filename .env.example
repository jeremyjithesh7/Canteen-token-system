# ==============================================================================
# CanteenOS Environment Configuration Template
# Copy this file to .env and fill in your environment-specific values.
# ==============================================================================

# Application Environment
PROJECT_NAME="Digital Canteen Token System"
ENV="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated list of allowed origins)
# For local development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# For Vercel production: https://your-canteen-app.vercel.app,http://localhost:3000,http://localhost:8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Database Connection URL
# 1. Local SQLite fallback (Development only):
# DATABASE_URL="sqlite:///./canteen.db"
#
# 2. Neon Serverless PostgreSQL (Production recommended):
# Use the POOLED connection string from Neon dashboard for serverless Vercel functions:
# Format: postgresql://[user]:[password]@[neon-pooler-host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/canteen_db?sslmode=require"

# JWT Authentication Secrets
# Generate a cryptographically secure random string: openssl rand -hex 32
SECRET_KEY="generate-a-strong-32-byte-hex-secret-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational & Kitchen Defaults
AVERAGE_PREPARATION_TIME_MINUTES=10
DEFAULT_DAILY_STOCK_LIMIT=100
LOW_STOCK_THRESHOLD_ALERT=10
CAMPUS_GST_PERCENT=5.0

# Predictive Engine Configuration
AI_MODEL_CONFIDENCE_THRESHOLD=0.75
CROWD_PEAK_THRESHOLD_QUEUE_DEPTH=8

# Campus UPI Configuration
UPI_VPA="canteen@upi"
UPI_PAYEE_NAME="Campus Canteen Services"
UPI_MERCHANT_CODE="5812"
