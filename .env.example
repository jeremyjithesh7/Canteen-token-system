# ==============================================================================
# CanteenOS Environment Configuration Template
# Clean Split Architecture: Render Backend + Vercel Frontend + Neon Database
# Copy this file to .env and fill in your environment-specific values.
# ==============================================================================

# Application Environment
PROJECT_NAME="Digital Canteen Token System"
ENV="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated list of allowed frontend origins)
# In production on Render: Set to your actual Vercel domain, e.g. https://your-canteen-app.vercel.app
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-canteen-app.vercel.app"

# Database Connection URL (Neon PostgreSQL Pooled connection string)
# Format: postgresql://[user]:[password]@[neon-pooler-host]/[dbname]?sslmode=require
# Local fallback: DATABASE_URL="sqlite:///./canteen.db"
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/canteen_db?sslmode=require"

# JWT Authentication Secrets
# Generate a cryptographically secure random string: openssl rand -hex 32
SECRET_KEY="generate-a-strong-32-byte-hex-secret-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational & Kitchen Defaults
AVERAGE_PREPARATION_TIME_MINUTES=10
DEFAULT_DAILY_STOCK_LIMIT=100
LOW_STOCK_THRESHOLD_ALERT=10
CAMPUS_GST_PERCENT=5.0

# Predictive Engine Configuration
AI_MODEL_CONFIDENCE_THRESHOLD=0.75
CROWD_PEAK_THRESHOLD_QUEUE_DEPTH=8

# Campus UPI Configuration (Override in Render to avoid personal default values)
UPI_VPA="canteen@upi"
UPI_PAYEE_NAME="Campus Canteen Services"
UPI_MERCHANT_CODE="5812"
