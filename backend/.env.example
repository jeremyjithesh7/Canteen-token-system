# Application Settings
PROJECT_NAME="Digital Canteen Token System"
ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# PostgreSQL default: postgresql://postgres:postgrespassword@localhost:5432/canteen_db
# SQLite local development default: sqlite:///./canteen.db
DATABASE_URL="sqlite:///./canteen.db"

# JWT Authentication
SECRET_KEY="canteen-super-secure-production-jwt-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Token & Kitchen System Settings
AVERAGE_PREPARATION_TIME_MINUTES=10
DEFAULT_DAILY_STOCK_LIMIT=100
LOW_STOCK_THRESHOLD_ALERT=10

# AI Prediction Configurations
AI_MODEL_CONFIDENCE_THRESHOLD=0.75
CROWD_PEAK_THRESHOLD_QUEUE_DEPTH=8

# Demo Payment Gateway
DEMO_PAYMENT_ENABLED=true
DEMO_PAYMENT_GATEWAY_NAME="DemoPay Gateway"
